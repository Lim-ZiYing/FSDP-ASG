# Copy this file to .env (copy .env.example .env)

# Fake data while routes are being built:
#   all     = everything fake, no server needed (good for demos)
#   unbuilt = real server for connected routes, fake for anything still in NOT_READY (api.js)
#   off     = everything real
VITE_MOCK=unbuilt

# Only if your API runs somewhere other than http://localhost:3000/api
# VITE_API_URL=http://localhost:3000/api