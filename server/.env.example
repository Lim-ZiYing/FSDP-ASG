# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Supabase: Project Settings -> API (or "Connect" button)
SUPABASE_URL=https://your-project-id.supabase.co
# The SERVICE ROLE key (secret). Server only - never put it in the React app.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Any long random string. Everyone on the team must use the SAME value
# if you share test accounts or tokens between laptops.
JWT_SECRET=change_me_to_a_long_random_string

# AI food check for photo uploads (Dana). Get a key at console.anthropic.com.
# Leave blank and uploads are saved as 'pending' (not shown on the eMenu).
ANTHROPIC_API_KEY=
# Optional: which Claude model runs the check (see docs/spike-FSDP-56-ai-provider.md)
AI_MODEL=claude-opus-5-5
# Local testing only: with no API key, approve every upload straight away
PHOTO_AUTO_APPROVE=false

# NETS QR sandbox (Declan fills these in)
NETS_API_KEY=
NETS_PROJECT_ID=
NETS_TXN_ID=
NETS_COURSE_INIT_ID=

ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
PHOTO_AUTO_APPROVE=false
