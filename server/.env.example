# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Supabase: Project Settings -> API (or "Connect" button)
SUPABASE_URL=https://your-project-id.supabase.co
# The SERVICE ROLE key (secret). Server only - never put it in the React app.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Any long random string. Everyone on the team must use the SAME value
# if you share test accounts or tokens between laptops.
JWT_SECRET=change_me_to_a_long_random_string

# AI food check for photo uploads (Dana). Get a free key at aistudio.google.com.
# Leave blank and uploads are saved as 'pending' (not shown on the eMenu).
GEMINI_API_KEY=
# Optional: which Gemini model runs the check (see docs/spike-FSDP-56-ai-provider.md)
GEMINI_MODEL=gemini-3.5-flash-lite
# Local testing only: with no API key, approve every upload straight away
PHOTO_AUTO_APPROVE=false

# NETS QR sandbox (Declan fills these in)
NETS_API_KEY=
NETS_PROJECT_ID=
